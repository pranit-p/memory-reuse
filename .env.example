# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and will never be committed.

# --- memory-reuse configuration (all optional) ---
# Backend: "memory" (default) or "redis"
MEMORY_REUSE_BACKEND=memory
# Redis connection URL (only needed when MEMORY_REUSE_BACKEND=redis)
# MEMORY_REUSE_REDIS_URL=redis://localhost:6379/0
# Default time-to-live in seconds ("none" for no expiry)
MEMORY_REUSE_DEFAULT_TTL=3600
# Default cache scope: "global", "user", or "session"
MEMORY_REUSE_DEFAULT_SCOPE=global

# --- LLM provider keys (only for the examples) ---
# Groq (used by examples/langgraph_math_agent.py)
# API_KEY=gsk_your_groq_key
# OpenAI
# OPENAI_API_KEY=sk-...
# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
